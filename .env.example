SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5050/callback

# Add these two settings to your existing .env when using Docker Compose.
# Choose separate, nonempty passwords before the first database startup.
MYSQL_PASSWORD=replace_with_an_app_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password
