<?xml version='1.0' encoding='UTF-8'?>
<archimate:model xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Music Room — Business and Technology Design" id="id-music-room" version="5.0.0">
  <folder name="Strategy" id="folder-strategy" type="strategy" />
  <folder name="Business" id="folder-business" type="business">
    <element xsi:type="archimate:BusinessActor" id="user" name="Music enthusiast">
      <documentation>Music enthusiast. Person using the application</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" id="curator" name="Library curator">
      <documentation>Library curator. Organize and explore music</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" id="manage" name="Manage music library">
      <documentation>Manage music library. Create, edit, delete, link records</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" id="discover" name="Discover music">
      <documentation>Discover music. Search catalogue and import music</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" id="listen" name="Control listening">
      <documentation>Control listening. Start or pause Spotify playback</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" id="collection" name="Personal music collection">
      <documentation>Personal music collection. Tracks, albums, artists and credits</documentation>
    </element>
  </folder>
  <folder name="Application" id="folder-application" type="application">
    <element xsi:type="archimate:ApplicationInterface" id="ui" name="Browser web UI">
      <documentation>Browser web UI. EJS pages, forms and Bootstrap</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" id="webapp" name="Music Room web app">
      <documentation>Music Room web app. Express routes and controllers</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" id="library-api" name="Library management">
      <documentation>Library management. Browse, filter, create, edit, delete</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" id="search-api" name="Discovery and import">
      <documentation>Discovery and import. Spotify search and library saves</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" id="play-api" name="Playback control">
      <documentation>Playback control. Play / pause on a Spotify device</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" id="spotify-api" name="Spotify Web API">
      <documentation>Spotify Web API. OAuth, catalogue, device control</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" id="library-module" name="Library module">
      <documentation>LibraryController, LibraryService, LibraryRepository and the Track, Album, Artist, PersonArtist and GroupArtist models. Implements library reads and transactional writes.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" id="records" name="Library records">
      <documentation>Logical data held in albums, tracks, artists, track_artists, album_artists and artist_memberships. Stores metadata and image URLs, not Spotify audio.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" id="spotify-adapter" name="Spotify integration">
      <documentation>Search, authorization, import metadata, and control playback using spotify-web-api-node. Tokens and refresh timer are in application memory, not user database sessions.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" id="spotify" name="Spotify platform">
      <documentation>Spotify platform. External service, outside Docker</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="folder-technology" type="technology">
    <element xsi:type="archimate:SystemSoftware" id="browser" name="Web browser">
      <documentation>Web browser. Renders pages and sends requests</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" id="hosting" name="Application hosting">
      <documentation>Application hosting. HTTP server on port 5050</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" id="persistence" name="Database persistence">
      <documentation>Database persistence. MySQL queries and transactions</documentation>
    </element>
    <element xsi:type="archimate:Node" id="docker" name="Docker Compose environment">
      <documentation>Docker deployment defined in compose.yaml. Composes the app and db container nodes; MySQL data is held in a named persistent volume.</documentation>
    </element>
    <element xsi:type="archimate:Node" id="app-container" name="App container">
      <documentation>App container. Node.js 24 · Express · app service</documentation>
    </element>
    <element xsi:type="archimate:Node" id="db-container" name="Database container">
      <documentation>Database container. MySQL 8.4 · db service · port 3306</documentation>
    </element>
    <element xsi:type="archimate:Artifact" id="database" name="Persistent music data">
      <documentation>Persistent music data. mysql_data volume · music schema</documentation>
    </element>
    <element xsi:type="archimate:Artifact" id="schema" name="Database initialization">
      <documentation>Database initialization. db.sql · imported on first startup</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="folder-motivation" type="motivation" />
  <folder name="Implementation &amp; Migration" id="folder-implementation_migration" type="implementation_migration" />
  <folder name="Other" id="folder-other" type="other" />
  <folder name="Relations" id="folder-relations" type="relations">
    <element xsi:type="archimate:AssignmentRelationship" id="r-user-role" name="takes role" source="user" target="curator" />
    <element xsi:type="archimate:AssignmentRelationship" id="r-role-manage" name="performs" source="curator" target="manage" />
    <element xsi:type="archimate:AssignmentRelationship" id="r-role-discover" name="performs" source="curator" target="discover" />
    <element xsi:type="archimate:AssignmentRelationship" id="r-role-listen" name="performs" source="curator" target="listen" />
    <element xsi:type="archimate:AccessRelationship" id="r-manage-collection" name="reads / writes" source="manage" target="collection" accessType="3" />
    <element xsi:type="archimate:ServingRelationship" id="r-library-serves" name="serves" source="library-api" target="manage" />
    <element xsi:type="archimate:ServingRelationship" id="r-discovery-serves" name="serves" source="search-api" target="discover" />
    <element xsi:type="archimate:ServingRelationship" id="r-playback-serves" name="serves" source="play-api" target="listen" />
    <element xsi:type="archimate:ServingRelationship" id="r-ui-role" name="serves" source="ui" target="curator" />
    <element xsi:type="archimate:CompositionRelationship" id="r-app-ui" name="exposes" source="webapp" target="ui" />
    <element xsi:type="archimate:CompositionRelationship" id="r-app-library" name="contains" source="webapp" target="library-module" />
    <element xsi:type="archimate:CompositionRelationship" id="r-app-spotify" name="contains" source="webapp" target="spotify-adapter" />
    <element xsi:type="archimate:RealizationRelationship" id="r-library-realizes" name="realizes" source="library-module" target="library-api" />
    <element xsi:type="archimate:RealizationRelationship" id="r-spotify-discovery" name="realizes" source="spotify-adapter" target="search-api" />
    <element xsi:type="archimate:RealizationRelationship" id="r-spotify-playback" name="realizes" source="spotify-adapter" target="play-api" />
    <element xsi:type="archimate:AccessRelationship" id="r-library-data" name="reads / writes" source="library-module" target="records" accessType="3" />
    <element xsi:type="archimate:RealizationRelationship" id="r-data-business" name="represents" source="records" target="collection" />
    <element xsi:type="archimate:RealizationRelationship" id="r-spotify-api-realization" name="realizes" source="spotify" target="spotify-api" />
    <element xsi:type="archimate:ServingRelationship" id="r-spotify-serves-adapter" name="serves" source="spotify-api" target="spotify-adapter" />
    <element xsi:type="archimate:ServingRelationship" id="r-browser-serves-ui" name="serves" source="browser" target="ui" />
    <element xsi:type="archimate:ServingRelationship" id="r-hosting-serves" name="hosts" source="hosting" target="webapp" />
    <element xsi:type="archimate:ServingRelationship" id="r-persistence-serves" name="serves" source="persistence" target="library-module" />
    <element xsi:type="archimate:RealizationRelationship" id="r-app-runtime" name="realizes" source="app-container" target="hosting" />
    <element xsi:type="archimate:RealizationRelationship" id="r-db-runtime" name="realizes" source="db-container" target="persistence" />
    <element xsi:type="archimate:CompositionRelationship" id="r-docker-app" name="contains" source="docker" target="app-container" />
    <element xsi:type="archimate:CompositionRelationship" id="r-docker-db" name="contains" source="docker" target="db-container" />
    <element xsi:type="archimate:AssignmentRelationship" id="r-db-artifact" name="stores" source="db-container" target="database" />
    <element xsi:type="archimate:RealizationRelationship" id="r-artifact-data" name="persists" source="database" target="records" />
    <element xsi:type="archimate:AccessRelationship" id="r-db-schema" name="reads on first startup" source="db-container" target="schema" accessType="1" />
  </folder>
  <folder name="Views" id="folder-diagrams" type="diagrams">
