digraph Classes {
  graph [rankdir=TB, bgcolor="#f5f7f6", pad="0.4", nodesep="0.5", ranksep="1.1", fontname="Helvetica", label="Music Room - implemented class diagram
Public attributes and methods; ? = nullable; inherited members are shown on the base class.", labelloc=t];
  node [shape=plain, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10, color="#476657", penwidth=1.2];
  Track [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#9bb3a4"><TR><TD BGCOLOR="#dceee2"><B>Track</B></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ id: Integer<BR ALIGN="LEFT"/>+ name: String<BR ALIGN="LEFT"/>+ duration_ms: Integer?<BR ALIGN="LEFT"/>+ image_url: String?<BR ALIGN="LEFT"/>+ spotify_id: String?<BR ALIGN="LEFT"/>+ spotify_uri: String?<BR ALIGN="LEFT"/>+ album_id: Integer?<BR ALIGN="LEFT"/>+ album_name: String?<BR ALIGN="LEFT"/>+ cover_url: String?<BR ALIGN="LEFT"/>+ album: Album?<BR ALIGN="LEFT"/>+ artists: Artist[]<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ setAlbum(album)<BR ALIGN="LEFT"/>+ getDisplayImage()<BR ALIGN="LEFT"/>+ getFormattedDuration()<BR ALIGN="LEFT"/>+ getArtists()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Album [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#9bb3a4"><TR><TD BGCOLOR="#dceee2"><B>Album</B></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ id: Integer<BR ALIGN="LEFT"/>+ name: String<BR ALIGN="LEFT"/>+ release_date: String?<BR ALIGN="LEFT"/>+ image_url: String?<BR ALIGN="LEFT"/>+ spotify_id: String?<BR ALIGN="LEFT"/>+ artists: Artist[]<BR ALIGN="LEFT"/>+ tracks: Track[]<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ getTracks()<BR ALIGN="LEFT"/>+ getArtists()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Artist [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#9bb3a4"><TR><TD BGCOLOR="#dceee2"><B>Artist</B></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ id: Integer<BR ALIGN="LEFT"/>+ name: String<BR ALIGN="LEFT"/>+ artist_type: String<BR ALIGN="LEFT"/>+ image_url: String?<BR ALIGN="LEFT"/>+ spotify_id: String?<BR ALIGN="LEFT"/>+ tracks: Track[]<BR ALIGN="LEFT"/>+ albums: Album[]<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ getTracks()<BR ALIGN="LEFT"/>+ getAlbums()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PersonArtist [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#9bb3a4"><TR><TD BGCOLOR="#dceee2"><B>PersonArtist</B></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ groups: GroupArtist[]<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ getGroups()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  GroupArtist [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#9bb3a4"><TR><TD BGCOLOR="#dceee2"><B>GroupArtist</B></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ members: PersonArtist[]<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ getMembers()<BR ALIGN="LEFT"/>+ addMember(person)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LibraryRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#9bb3a4"><TR><TD BGCOLOR="#dceee2"><B>LibraryRepository</B></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ pool: MySQL Pool<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ rows(sql, values = [])<BR ALIGN="LEFT"/>+ credits(items, table, column)<BR ALIGN="LEFT"/>+ loadTracks(condition = '', values = [], order = 't.name, t.id')<BR ALIGN="LEFT"/>+ findTracks()<BR ALIGN="LEFT"/>+ findAlbums()<BR ALIGN="LEFT"/>+ findArtists()<BR ALIGN="LEFT"/>+ findTrack(id)<BR ALIGN="LEFT"/>+ findAlbum(id)<BR ALIGN="LEFT"/>+ findArtist(id)<BR ALIGN="LEFT"/>+ addMembership(groupId, memberId)<BR ALIGN="LEFT"/>+ transaction(work)<BR ALIGN="LEFT"/>+ insert(connection, table, data)<BR ALIGN="LEFT"/>+ linkArtists(connection, table, ownerColumn, ownerId, artistIds)<BR ALIGN="LEFT"/>+ importArtists(connection, artists = [])<BR ALIGN="LEFT"/>+ importAlbum(connection, album)<BR ALIGN="LEFT"/>+ importTrack(connection, track, albumId)<BR ALIGN="LEFT"/>+ saveSpotify(album, tracks)<BR ALIGN="LEFT"/>+ membership(connection, groupId, memberId)<BR ALIGN="LEFT"/>+ saveManual(kind, data, {artistIds, groupIds, memberIds, updateArtistType})<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LibraryService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#9bb3a4"><TR><TD BGCOLOR="#dceee2"><B>LibraryService</B></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ repository: LibraryRepository<BR ALIGN="LEFT"/>+ spotifyClient: SpotifyClient<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ saveTrack(uri)<BR ALIGN="LEFT"/>+ saveAlbum(uri)<BR ALIGN="LEFT"/>+ saveSpotify(uri, target)<BR ALIGN="LEFT"/>+ addMembership(groupId, memberId)<BR ALIGN="LEFT"/>+ saveManual(kind, body = {})<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SpotifyClient [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#9bb3a4"><TR><TD BGCOLOR="#dceee2"><B>SpotifyClient</B></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ api: SpotifyWebApi<BR ALIGN="LEFT"/>+ refreshTimer: Timeout?<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ isAuthenticated()<BR ALIGN="LEFT"/>+ resetAccessToken()<BR ALIGN="LEFT"/>+ createAuthorizeURL(scopes, reauthorize = false)<BR ALIGN="LEFT"/>+ authorize(code)<BR ALIGN="LEFT"/>+ logout()<BR ALIGN="LEFT"/>+ searchTracks(query)<BR ALIGN="LEFT"/>+ getTrack(id)<BR ALIGN="LEFT"/>+ getAlbum(id)<BR ALIGN="LEFT"/>+ getAlbumTracks(id, options)<BR ALIGN="LEFT"/>+ play(uri)<BR ALIGN="LEFT"/>+ pause()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  HomeController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#9bb3a4"><TR><TD BGCOLOR="#dceee2"><B>HomeController</B></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">&#160;</TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ index(req, res)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LibraryController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#9bb3a4"><TR><TD BGCOLOR="#dceee2"><B>LibraryController</B></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ repository: LibraryRepository<BR ALIGN="LEFT"/>+ service: LibraryService<BR ALIGN="LEFT"/>+ spotifyClient: SpotifyClient<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ listTracks(req, res)<BR ALIGN="LEFT"/>+ listAlbums(req, res)<BR ALIGN="LEFT"/>+ listArtists(req, res)<BR ALIGN="LEFT"/>+ missing(res, label)<BR ALIGN="LEFT"/>+ showTrack(req, res)<BR ALIGN="LEFT"/>+ showAlbum(req, res)<BR ALIGN="LEFT"/>+ showArtist(req, res)<BR ALIGN="LEFT"/>+ readError(error, req, res)<BR ALIGN="LEFT"/>+ writeError(error, res)<BR ALIGN="LEFT"/>+ addAlbum(req, res)<BR ALIGN="LEFT"/>+ addTrack(req, res)<BR ALIGN="LEFT"/>+ addArtist(req, res)<BR ALIGN="LEFT"/>+ addManual(kind, req, res)<BR ALIGN="LEFT"/>+ addMembership(req, res)<BR ALIGN="LEFT"/>+ save(req, res)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SpotifyController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#9bb3a4"><TR><TD BGCOLOR="#dceee2"><B>SpotifyController</B></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ spotifyClient: SpotifyClient<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ login(req, res)<BR ALIGN="LEFT"/>+ search(req, res)<BR ALIGN="LEFT"/>+ play(req, res)<BR ALIGN="LEFT"/>+ pause(req, res)<BR ALIGN="LEFT"/>+ playback(action, req, res)<BR ALIGN="LEFT"/>+ showTrack(req, res)<BR ALIGN="LEFT"/>+ callback(req, res)<BR ALIGN="LEFT"/>+ logout(req, res)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ValidationError [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#9bb3a4"><TR><TD BGCOLOR="#dceee2"><B>ValidationError</B></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">+ name: String<BR ALIGN="LEFT"/>+ statusCode: Integer<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT">&#160;</TD></TR></TABLE>>];
  Error [label="Error (JavaScript built-in)", shape=box, style=rounded];
  PersonArtist -> Artist [arrowhead=onormal, label="inherits"];
  GroupArtist -> Artist [arrowhead=onormal, label="inherits"];
  ValidationError -> Error [arrowhead=onormal, label="inherits"];
  Album -> Track [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="0..1", headlabel="0..*", label="contains"];
  Artist -> Track [dir=none, taillabel="0..*", headlabel="0..*", label="credited on"];
  Artist -> Album [dir=none, taillabel="0..*", headlabel="0..*", label="credited on"];
  GroupArtist -> PersonArtist [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="0..*", headlabel="0..*", label="members"];
  LibraryController -> LibraryService [arrowhead=vee, taillabel="1", headlabel="1", label="uses"];
  LibraryController -> LibraryRepository [arrowhead=vee, taillabel="1", headlabel="1", label="reads"];
  LibraryController -> SpotifyClient [arrowhead=vee, taillabel="1", headlabel="1", label="checks login"];
  LibraryService -> LibraryRepository [arrowhead=vee, taillabel="1", headlabel="1", label="persists through"];
  LibraryService -> SpotifyClient [arrowhead=vee, taillabel="1", headlabel="1", label="imports through"];
  SpotifyController -> SpotifyClient [arrowhead=vee, taillabel="1", headlabel="1", label="uses"];
  LibraryRepository -> Track [style=dashed, arrowhead=vee, label="creates"];
  LibraryRepository -> Album [style=dashed, arrowhead=vee, label="creates"];
  LibraryRepository -> Artist [style=dashed, arrowhead=vee, label="creates through factory"];
  LibraryService -> ValidationError [style=dashed, arrowhead=vee, label="throws"];
}
