<%- include('partials/library-start') %>
<a href="/<%= kind.slice(0, -1) %>/<%= record.id %>" class="text-success text-decoration-none">‹ Back to <%= record.name %></a>
<section class="bg-white border rounded-4 p-4 p-md-5 mt-4 mx-auto edit-record-panel">
    <p class="text-secondary small text-uppercase">Your library · ID <%= record.id %></p>
    <h1 class="h2 fw-bold mb-4">Edit <%= kind.slice(0, -1) %></h1>
    <% if (error) { %><div class="alert alert-danger rounded-4" role="alert"><%= error %></div><% } %>
    <form action="/<%= kind.slice(0, -1) %>/<%= record.id %>/edit" method="POST">
        <%- include('partials/record-fields', {kind, values, albums}) %>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary rounded-pill px-4">Save changes</button>
            <a href="/<%= kind.slice(0, -1) %>/<%= record.id %>" class="btn btn-outline-secondary rounded-pill">Cancel</a>
        </div>
    </form>
</section>
<%- include('partials/library-end') %>
