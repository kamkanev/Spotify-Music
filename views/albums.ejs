<%- include('partials/library-start') %>
<header class="discovery-panel rounded-4 p-4 p-md-5 mb-4">
    <p class="text-success small fw-semibold text-uppercase">Your library</p>
    <h1 class="display-5 fw-bold">Albums</h1>
    <p class="text-secondary mb-0"><%= albums.length %> albums shown. Explore the releases in your collection.</p>
</header>
<div class="d-flex justify-content-end mb-3">
    <a href="/albums/new" class="btn btn-primary rounded-pill px-4">+ Add album manually</a>
</div>
<%- include('partials/library-notice') %>
<%- include('partials/library-filters', {kind: 'albums'}) %>
<% if (!albums.length && (filters.q || filters.source !== 'all')) { %>
    <p class="text-secondary">No albums match your search or filters.</p>
<% } else { %>
<%- include('partials/album-grid', {albums}) %>
<% if (!albums.length) { %><a href="/" class="btn btn-outline-success rounded-pill">Find music to save</a><% } %>
<% } %>
<%- include('partials/library-end') %>
