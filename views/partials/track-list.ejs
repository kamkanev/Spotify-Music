<% if (!tracks.length) { %>
    <p class="text-secondary mb-0">No tracks saved here yet.</p>
<% } else { %>
    <div class="list-group list-group-flush">
        <% tracks.forEach(track => { %>
            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" href="/track/<%= track.id %>">
                <% if (track.getDisplayImage()) { %>
                    <img src="<%= track.getDisplayImage() %>" alt="<%= track.name %> cover" width="64" height="64" class="rounded flex-shrink-0">
                <% } else { %>
                    <span class="cover-placeholder rounded d-flex align-items-center justify-content-center flex-shrink-0" aria-hidden="true">♫</span>
                <% } %>
                <div class="track-copy">
                    <h3 class="h6 fw-semibold mb-1"><%= track.name %></h3>
                    <p class="text-secondary small mb-0"><%= track.artists.map(a => a.name).join(' / ') || 'No artist credits' %></p>
                    <% if (track.album_name) { %><p class="small text-secondary mb-0"><%= track.album_name %></p><% } %>
                </div>
                <% if (track.duration_ms != null) { %>
                    <span class="small text-secondary ms-auto text-nowrap"><%= track.getFormattedDuration() %></span>
                <% } %>
                <span class="text-secondary" aria-hidden="true">›</span>
            </a>
        <% }); %>
    </div>
<% } %>
