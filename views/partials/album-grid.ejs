<% if (!albums.length) { %>
    <p class="text-secondary">No albums saved here yet.</p>
<% } else { %>
    <div class="row g-3">
        <% albums.forEach(album => { %>
            <div class="col-sm-6 col-lg-4">
                <article class="card border-0 rounded-4 shadow-sm h-100">
                    <div class="card-body p-4">
                        <a href="/album/<%= album.id %>" class="text-reset text-decoration-none">
                            <% if (album.image_url) { %>
                                <img src="<%= album.image_url %>" alt="<%= album.name %> cover" class="library-cover rounded-3 mb-3" loading="lazy">
                            <% } else { %>
                                <div class="library-cover discovery-panel rounded-3 mb-3 d-flex align-items-center justify-content-center display-3 text-success" aria-hidden="true">♫</div>
                            <% } %>
                            <h3 class="h5 fw-bold"><%= album.name %></h3>
                        </a>
                        <p class="small mb-2"><%- include('artist-links', {artists: album.artists}) %></p>
                        <% if (album.release_date) { %><p class="small text-secondary mb-0"><%= album.release_date %></p><% } %>
                    </div>
                </article>
            </div>
        <% }); %>
    </div>
<% } %>
