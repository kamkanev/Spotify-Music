<form class="search-form d-flex gap-2 mx-auto bg-white p-2 rounded-4 border shadow-sm" role="search" action="/search" method="GET">
    <label class="visually-hidden" for="track-search">Search tracks</label>
    <input id="track-search" class="form-control border-0 shadow-none bg-transparent" type="search" name="q" placeholder="Search for a song or artist…" required>
    <button class="btn btn-success rounded-3 px-4" type="submit">Search</button>
</form>
