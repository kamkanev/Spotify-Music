<% if (!artists.length) { %>
    <p class="text-secondary">No artists saved here yet.</p>
<% } else { %>
    <div class="row g-3">
        <% artists.forEach(artist => { %>
            <div class="col-sm-6 col-lg-4">
                <a href="/artist/<%= artist.id %>" class="card h-100 border-0 rounded-4 shadow-sm text-reset text-decoration-none">
                    <div class="card-body p-4 d-flex align-items-center gap-3">
                        <% if (artist.image_url) { %>
                            <img src="<%= artist.image_url %>" width="64" height="64" alt="<%= artist.name %>" class="rounded-circle flex-shrink-0" loading="lazy">
                        <% } else { %>
                            <span class="cover-placeholder rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-success fw-bold" aria-hidden="true"><%= artist.name.charAt(0) %></span>
                        <% } %>
                        <div class="track-copy">
                            <h3 class="h5 fw-bold mb-1"><%= artist.name %></h3>
                            <p class="small text-secondary text-capitalize mb-0"><%= artist.artist_type === 'unknown' || !artist.artist_type ? 'Artist' : artist.artist_type %></p>
                        </div>
                    </div>
                </a>
            </div>
        <% }); %>
    </div>
<% } %>
