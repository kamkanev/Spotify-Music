<%- include('partials/library-start') %>
<header class="discovery-panel rounded-4 p-4 p-md-5 mb-4">
    <p class="text-success small fw-semibold text-uppercase">Your library</p>
    <h1 class="display-5 fw-bold">Tracks</h1>
    <p class="text-secondary mb-0"><%= tracks.length %> tracks shown. Find a favorite and explore its details.</p>
</header>
<div class="d-flex justify-content-end mb-3">
    <a href="/tracks/new" class="btn btn-primary rounded-pill px-4">+ Add track</a>
</div>
<%- include('partials/library-notice') %>
<%- include('partials/library-filters', {kind: 'tracks'}) %>
<% if (!tracks.length && (filters.q || filters.source !== 'all')) { %>
    <p class="text-secondary">No tracks match your search or filters.</p>
<% } else { %>
<section class="bg-white rounded-4 border p-3 p-md-4">
    <%- include('partials/track-list', {tracks}) %>
    <% if (!tracks.length) { %><a href="/" class="btn btn-outline-success rounded-pill mt-3">Find music to save</a><% } %>
</section>
<% } %>
<%- include('partials/library-end') %>
